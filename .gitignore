# Runtime data — never committed
db/
jobs/
events/
*.db
*.sqlite
*.sqlite3

# node_status_history entries (local); keep README + AGENTS tracked
node_status_history/**
!node_status_history/README.md
!node_status_history/AGENTS.md

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/
.coverage
coverage/
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
*.key
*.token

# Logs
*.log

# Graphify rebuild cache
graphify-out/cache/
graphify-out.pi-local-backup

# Local agent/tooling state
.pi/
.serena/

# ByteRover — .brv/context-tree/ contains a nested .git managed by brv vc.
# Without these entries, `git add .` fails with "does not have a commit checked out".
.brv/
.aider*
.vectorcode/

# mini-heartbeat local env (paths only, but keep untracked)
deploy/mini-heartbeat/env/gddp.env

# generated by graphify commit hook — rebuildable, never commit
graphify-out/

# Understand-Anything scratch artifacts (never commit)
.ua/intermediate/
.ua/tmp/
.ua/.trash-*/
.ua/diff-overlay.json
node_modules/
.pi_subagents/
.pi-subagents/
.worktrees/
.superpowers/
