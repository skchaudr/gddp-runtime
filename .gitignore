# ByteRover — .brv/context-tree/ contains a nested .git managed by brv vc.
# Without these entries, `git add .` fails with "does not have a commit checked out".
.brv/
.aider*
.vectorcode/

# mini-heartbeat / rig1 local env (paths only, but keep untracked)
deploy/mini-heartbeat/env/gddp.env
deploy/rig1-heartbeat/env/gddp.env

# generated by graphify commit hook — rebuildable, never commit
graphify-out/

# Understand-Anything scratch artifacts (never commit)
.ua/intermediate/
.ua/tmp/
.ua/.trash-*/
.ua/diff-overlay.json
node_modules/
package-lock.json
.pi_subagents/
.pi-subagents/
.worktrees/
.superpowers/

