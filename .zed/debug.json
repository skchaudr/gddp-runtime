[
  {
    "label": "GDDP: current Python file",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT:$ZED_WORKTREE_ROOT/scripts"
    },
    "justMyCode": true,
    "showReturnValue": true
  },
  {
    "label": "GDDP: current pytest file",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["-q", "-s", "--maxfail=1", "$ZED_RELATIVE_FILE"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT:$ZED_WORKTREE_ROOT/scripts"
    },
    "justMyCode": true,
    "showReturnValue": true
  },
  {
    "label": "GDDP: five-minute debugger tour",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [
      "-q",
      "-s",
      "--maxfail=1",
      "scripts/runtime/verification/test_retry_budget.py::TestShouldRetry::test_non_pass_with_evidence_and_budget_and_room_returns_true"
    ],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT:$ZED_WORKTREE_ROOT/scripts"
    },
    "justMyCode": true,
    "showReturnValue": true
  },
  {
    "label": "GDDP: last failed test",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["-q", "-s", "--lf", "--last-failed-no-failures=none", "--maxfail=1"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT:$ZED_WORKTREE_ROOT/scripts"
    },
    "justMyCode": true,
    "showReturnValue": true
  },
  {
    "label": "GDDP: intake server",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/scripts/intake_server.py",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "GDDP_RUNTIME_ROOT": "$ZED_WORKTREE_ROOT",
      "PYTHONPATH": "$ZED_WORKTREE_ROOT:$ZED_WORKTREE_ROOT/scripts"
    },
    "jinja": true,
    "justMyCode": true,
    "showReturnValue": true
  }
]
