+++ b/scripts/echo.py
@@ -0,0 +1,7 @@
+def echo(msg: str) -> str:
+    """Returns the message string unchanged."""
+    return msg
+
+def echo_loud(msg: str) -> str:
+    """Returns the message uppercased with '!' appended."""
+    return f"{msg.upper()}!"
