# Copy to deploy/rig1-heartbeat/env/gddp.env (gitignored) and edit if needed.
# No secrets in this file — only resolver commands and paths.

# Runtime + graph (sibling checkouts under ~/repos is the default)
export GDDP_RUNTIME_ROOT="${GDDP_RUNTIME_ROOT:-$HOME/repos/gddp-runtime}"
export GDDP_CONFIG_PATH="${GDDP_CONFIG_PATH:-$HOME/repos/gddp-config}"
export GDDP_REPOS_ROOT="${GDDP_REPOS_ROOT:-$HOME/repos}"
export GDDP_REPO_ROOT="${GDDP_REPO_ROOT:-$HOME/repos}"

# Heartbeat target
export GDDP_PROJECT_ID="${GDDP_PROJECT_ID:-gddp-runtime}"
export GDDP_PROJECT_REPO="${GDDP_PROJECT_REPO:-skchaudr/gddp-runtime}"

# Prefer runtime .venv (common.sh resolves if unset)
# export GDDP_PYTHON="$GDDP_RUNTIME_ROOT/.venv/bin/python"

# Jules API — Keychain on sab-air. USER expands when this file is sourced
# (before plist render). Do not leave bare $USER in a hand-written plist.
export GDDP_JULES_KEY_CMD="${GDDP_JULES_KEY_CMD:-security find-generic-password -w -s jules-api-key -a ${USER}}"
# Optional: export JULES_API_KEY=... for interactive sessions instead

# DeepSeek for verification bridge when evaluator runs on returns
export GDDP_DEEPSEEK_KEY_CMD="${GDDP_DEEPSEEK_KEY_CMD:-pass show api/deepseek}"

# Local executor optional on this rig (Jules is primary)
export GDDP_LOCAL_SUBPROCESS_SPOOL_DIR="${GDDP_LOCAL_SUBPROCESS_SPOOL_DIR:-$GDDP_RUNTIME_ROOT/jobs/local-subprocess-spool}"
