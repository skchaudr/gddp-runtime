# Copy to ~/repos/gddp-runtime/deploy/mini-heartbeat/env/gddp.env (gitignored)
# and edit paths if your layout differs. No secrets in this file.

# Runtime + graph (sibling checkouts under ~/repos is the default)
export GDDP_RUNTIME_ROOT="${GDDP_RUNTIME_ROOT:-$HOME/repos/gddp-runtime}"
export GDDP_CONFIG_PATH="${GDDP_CONFIG_PATH:-$HOME/repos/gddp-config}"
export GDDP_REPOS_ROOT="${GDDP_REPOS_ROOT:-$HOME/repos}"
export GDDP_REPO_ROOT="${GDDP_REPO_ROOT:-$HOME/repos}"

# Heartbeat target (match big-ssd cron defaults)
export GDDP_PROJECT_ID="${GDDP_PROJECT_ID:-gddp-runtime}"
export GDDP_PROJECT_REPO="${GDDP_PROJECT_REPO:-skchaudr/gddp-runtime}"

# Python for launchd (defaults to .venv/bin/python if present)
# export GDDP_PYTHON="$GDDP_RUNTIME_ROOT/.venv/bin/python"

# Factory Mission model profile. Pin all six values before dispatch; the
# adapter passes them to Droid and records the exact profile + argv in
# db/mission-sessions/<engagement-id>/session.json.
# Verify model IDs and supported efforts with the installed `droid exec --help`
# and `droid exec -m <id> -r <effort> --list-tools`.
# export GDDP_MISSION_MODEL="gpt-5.6-sol"
# export GDDP_MISSION_REASONING_EFFORT="high"
# export GDDP_MISSION_WORKER_MODEL="grok-4.5"
# export GDDP_MISSION_WORKER_REASONING_EFFORT="high"
# export GDDP_MISSION_VALIDATOR_MODEL="gpt-5.6-terra"
# export GDDP_MISSION_VALIDATOR_REASONING_EFFORT="high"

# DeepSeek for verification bridge (evaluator pi sandboxes HOME)
export GDDP_DEEPSEEK_KEY_CMD="${GDDP_DEEPSEEK_KEY_CMD:-pass show api/deepseek}"
# Optional: export DEEPSEEK_API_KEY=... for interactive sessions instead

# Jules API for remote execution. Keep the key in the password store.
export GDDP_JULES_KEY_CMD="${GDDP_JULES_KEY_CMD:-pass show api/jules}"
# Optional: export JULES_API_KEY=... for interactive sessions instead

# Local executor. ARGV is a JSON array; pin it to a route already smoke-tested.
# export GDDP_LOCAL_SUBPROCESS_ARGV='["/absolute/path/to/wrapper","--","agent",...]'
# Canonical local attempt spool (cursor/pi/local/droid). The legacy name
# GDDP_LOCAL_SUBPROCESS_SPOOL_DIR is still read when this is unset.
export GDDP_ATTEMPT_SPOOL_DIR="${GDDP_ATTEMPT_SPOOL_DIR:-${GDDP_LOCAL_SUBPROCESS_SPOOL_DIR:-$GDDP_RUNTIME_ROOT/jobs/local-subprocess-spool}}"
export GDDP_LOCAL_SUBPROCESS_SPOOL_DIR="${GDDP_LOCAL_SUBPROCESS_SPOOL_DIR:-$GDDP_ATTEMPT_SPOOL_DIR}"
# Optional: droid executor (Factory droid exec). Nodes opt in via
# allowed_execution_modes: [droid]. Without this, the droid adapter uses its
# built-in default argv (droid exec --auto high, droid's own default model).
# export GDDP_DROID_SUBPROCESS_ARGV='["/usr/bin/python3","/absolute/path/to/local_agent_executor.py","--","/path/to/droid","exec","--auto","high","-m","grok-4.5"]'
# Prefer Droid Core catalog IDs (droid exec --list-tools); custom:* models may
# depend on local proxies that are not part of this kit.

# Pi RPC executor
# export GDDP_PI_RPC_MODEL="openai-codex/gpt-5.6-sol"
# export GDDP_PI_RPC_TURN_TIMEOUT_S="7200"
# export GDDP_PI_RPC_TOOLS="read,grep,find,ls,subagent"
# Webhook intake — required before arm (intake fails closed without a secret).
# Target: local pass after migrating pi-big store.
# export GDDP_WEBHOOK_SECRET_CMD='pass show gddp/webhook-secret'
# Transition: remote resolver until pass is on mini (used for canary recovery 2026-07-12):
# export GDDP_WEBHOOK_SECRET_CMD='ssh -o BatchMode=yes pi-big "pass show gddp/webhook-secret"'
export GDDP_WEBHOOK_SECRET_CMD="${GDDP_WEBHOOK_SECRET_CMD:-pass show gddp/webhook-secret}"

# Integrity lane default is on in bridge; override only for local debug
# export GDDP_INTEGRITY_MODE=off
