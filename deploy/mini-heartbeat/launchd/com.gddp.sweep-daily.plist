<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GDDP sweep on sab-mini (daily 05:30). One bounded evaluation-coverage shift.
  Machine-off days are simply skipped — the next run catches accumulated gaps
  by design, so no catch-up logic is required.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gddp.sweep-daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/bin/gddp-sweep-daily</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/gddp-sweep-daily.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/gddp-sweep-daily.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
