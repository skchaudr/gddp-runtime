<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GDDP heartbeat on sab-mini (every 5 minutes). Dormant until bin/arm.sh.
  Mirrors big-ssd user crontab: python3 -m scripts.runtime.heartbeat.runner
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gddp.heartbeat</string>

  <key>WorkingDirectory</key>
  <string>__GDDP_RUNTIME_ROOT__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__GDDP_PYTHON__</string>
    <string>-m</string>
    <string>scripts.runtime.heartbeat.runner</string>
    <string>--all-active</string>
    <string>--config-path</string>
    <string>__GDDP_CONFIG_PATH__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:__HOME__/.local/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>GDDP_RUNTIME_ROOT</key>
    <string>__GDDP_RUNTIME_ROOT__</string>
    <key>GDDP_CONFIG_PATH</key>
    <string>__GDDP_CONFIG_PATH__</string>
    <key>GDDP_REPOS_ROOT</key>
    <string>__GDDP_REPOS_ROOT__</string>
    <key>GDDP_REPO_ROOT</key>
    <string>__GDDP_REPOS_ROOT__</string>
    <key>GDDP_DEEPSEEK_KEY_CMD</key>
    <string>__GDDP_DEEPSEEK_KEY_CMD__</string>
    <key>GDDP_JULES_KEY_CMD</key>
    <string>__GDDP_JULES_KEY_CMD__</string>
    <key>GDDP_LOCAL_SUBPROCESS_ARGV</key>
    <string>__GDDP_LOCAL_SUBPROCESS_ARGV__</string>
    <key>GDDP_DROID_SUBPROCESS_ARGV</key>
    <string>__GDDP_DROID_SUBPROCESS_ARGV__</string>
    <key>GDDP_LOCAL_SUBPROCESS_SPOOL_DIR</key>
    <string>__GDDP_LOCAL_SUBPROCESS_SPOOL_DIR__</string>
    <key>PYTHONPATH</key>
    <string>__GDDP_RUNTIME_ROOT__</string>

    <!--
      Droid/executor telemetry. Droid reads OTEL_TELEMETRY_ENDPOINT first, then
      OTEL_EXPORTER_OTLP_ENDPOINT. These must live here: droid inherits only what
      launchd sets, so an interactive shell's exports never reach an executor.
      Export interval is short because a `droid exec` run often finishes well
      inside the 60s SDK default.
    -->
    <key>OTEL_EXPORTER_OTLP_ENDPOINT</key>
    <string>http://127.0.0.1:4319</string>
    <key>OTEL_EXPORTER_OTLP_PROTOCOL</key>
    <string>http/protobuf</string>
    <key>OTEL_SERVICE_NAME</key>
    <string>gddp-droid</string>
    <key>OTEL_RESOURCE_ATTRIBUTES</key>
    <string>gddp.role=executor,deployment.environment=gddp</string>
    <key>OTEL_METRIC_EXPORT_INTERVAL</key>
    <string>10000</string>
  </dict>

  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/gddp-heartbeat.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/gddp-heartbeat.err.log</string>
</dict>
</plist>
